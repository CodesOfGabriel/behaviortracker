{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Behavior Tracker",
  "version": "0.1.1",
  "identifier": "com.behavetracker.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "node scripts/prepare-video-tools.mjs && node scripts/check-release-models.mjs && npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Behavior Tracker",
        "width": 1180,
        "height": 760,
        "minWidth": 980,
        "minHeight": 620,
        "center": true,
        "resizable": true,
        "decorations": false,
        "fullscreen": false
      }
    ],
    "security": {
      "assetProtocol": { "enable": true, "scope": ["$APPDATA/results/*", "$APPCACHE/video-staging/*"] },
      "csp": "default-src 'self'; img-src 'self' data: blob: asset: https://asset.localhost; media-src 'self' blob: asset: http://asset.localhost https://asset.localhost; style-src 'self' 'unsafe-inline'; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "externalBin": ["binaries/behavetracker-ffmpeg", "binaries/behavetracker-ffprobe"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "resources": {
      "binaries/VIDEO_TOOLS_LICENSE.txt": "licenses/VIDEO_TOOLS_LICENSE.txt",
      "../models/wistar_df_v2/best_detector.pth": "models/wistar_df_v2/best_detector.pth",
      "../models/wistar_df_v2/snapshot-hrnet_w32-001.pt": "models/wistar_df_v2/snapshot-hrnet_w32-001.pt",
      "../models/wistar_df_v2/pytorch_config.yaml": "models/wistar_df_v2/pytorch_config.yaml",
      "../models/wistar_df_v2/manifest.json": "models/wistar_df_v2/manifest.json"
    }
  }
}
